{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "default_agent": "build",
  "compaction": { "auto": true },
  "tool_output": { "max_lines": 250, "max_bytes": 24000 },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status --short", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "git diff --stat", "effect": "allow" },
    { "action": "shell", "resource": "git diff --check", "effect": "allow" },
    { "action": "shell", "resource": "npm run harness:check", "effect": "allow" },
    { "action": "shell", "resource": "npm run env:check", "effect": "allow" },
    { "action": "shell", "resource": "npm test", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck", "effect": "allow" },
    { "action": "shell", "resource": "npm run build", "effect": "allow" },
    { "action": "shell", "resource": "npm run test:e2e", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true
      }
    }
  }
}
